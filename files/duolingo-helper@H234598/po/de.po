#. settings-schema.json->users->description
msgid "Duolingo users"
msgstr "Duolingo-Benutzer"

#. settings-schema.json->users->tooltip
msgid "Add one enabled row per Duolingo username. Alias only changes the display name. Standalone limits hover and click views when the matching display options are enabled."
msgstr "Fuege pro Duolingo-Benutzername eine aktivierte Zeile hinzu. Alias aendert nur den Anzeigenamen. Standalone begrenzt Hover- und Klickansichten, wenn die passenden Anzeigeoptionen aktiv sind."

#. settings-schema.json->users->columns->enabled->title
msgid "Enabled"
msgstr "Enabled"

#. settings-schema.json->users->columns->enabled->tooltip
msgid "Include this user in Duolingo checks and applet displays."
msgstr "Nimmt diesen Benutzer in Duolingo-Abfragen und Applet-Anzeigen auf."

#. settings-schema.json->users->columns->highlighted->title
msgid "Highlight"
msgstr "Hervorheben"

#. settings-schema.json->users->columns->highlighted->tooltip
msgid "Highlights this user in the click menu and, when enabled, in the hover tooltip."
msgstr "Hebt diesen Benutzer im Klickmenue hervor und, wenn aktiviert, auch im Hover-Tooltip."

#. settings-schema.json->users->columns->simulateActive->title
msgid "Simmulate active"
msgstr "Aktiv simmulieren"

#. settings-schema.json->users->columns->simulateActive->tooltip
msgid "Simulates that this user is online even when Duolingo does not report them as active."
msgstr "Simuliert, dass dieser Benutzer online ist, auch wenn Duolingo ihn nicht als aktiv meldet."

#. settings-schema.json->users->columns->standalone->title
msgid "Standalone"
msgstr "Standalone"

#. settings-schema.json->users->columns->standalone->tooltip
msgid "Shows this user in hover and click views when those views are limited to Standalone users. The first Standalone user is used for self-style panel values and the automatic self-online icon."
msgstr "Zeigt diesen Benutzer in Hover- und Klickansichten, wenn diese Ansichten auf Standalone-Benutzer begrenzt sind. Der erste Standalone-Benutzer wird fuer Selbst-Werte im Panel und das automatische Selbst-online-Symbol verwendet."

#. settings-schema.json->users->columns->username->title
msgid "Username"
msgstr "Benutzername"

#. settings-schema.json->users->columns->username->tooltip
msgid "The public Duolingo username. This exact value is used for API requests and profile links."
msgstr "Der oeffentliche Duolingo-Benutzername. Genau dieser Wert wird fuer API-Anfragen und Profillinks verwendet."

#. settings-schema.json->users->columns->alias->title
msgid "Alias"
msgstr "Alias"

#. settings-schema.json->users->columns->alias->tooltip
msgid "Optional local display name. Leave empty to show the Duolingo username."
msgstr "Optionaler lokaler Anzeigename. Leer lassen, um den Duolingo-Benutzernamen zu zeigen."
