{
  "hover-display-mode": {
    "type": "combobox",
    "description": "Show on hover",
    "options": {
      "Nothing": "none",
      "Summary": "summary",
      "Course details": "courses",
      "Account details": "account",
      "All details": "all"
    },
    "default": "summary"
  },
  "click-display-mode": {
    "type": "combobox",
    "description": "Show on click",
    "options": {
      "Nothing": "none",
      "Summary": "summary",
      "Course details": "courses",
      "Account details": "account",
      "All details": "all"
    },
    "default": "summary"
  },
  "panel-display-mode": {
    "type": "combobox",
    "description": "Show in panel",
    "options": {
      "Compact user/streak summary": "compact",
      "Loaded user count": "users",
      "Total streak": "streak",
      "Total XP": "xp",
      "Nothing": "none"
    },
    "default": "compact"
  },
  "sort-order": {
    "type": "combobox",
    "description": "Sort users by",
    "options": {
      "Configured order": "configured",
      "Alias or username A-Z": "username-asc",
      "Alias or username Z-A": "username-desc",
      "Streak high to low": "streak-desc",
      "Streak low to high": "streak-asc",
      "Total XP high to low": "xp-desc",
      "Total XP low to high": "xp-asc"
    },
    "default": "configured"
  },
  "users": {
    "type": "list",
    "description": "Duolingo users",
    "columns": [
      {
        "id": "enabled",
        "title": "Enabled",
        "type": "boolean",
        "default": true
      },
      {
        "id": "highlighted",
        "title": "Highlight",
        "type": "boolean",
        "default": false
      },
      {
        "id": "username",
        "title": "Username",
        "type": "string",
        "default": ""
      },
      {
        "id": "alias",
        "title": "Alias",
        "type": "string",
        "default": ""
      }
    ],
    "height": 260,
    "default": []
  }
}
